# Copy this file to ".env" (keep this one!) and fill it in. Never share .env: the token controls your bot.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → your application → General Information → Application ID
DISCORD_CLIENT_ID=
# In Discord: Settings → Advanced → Developer Mode ON, then right-click your server icon → Copy Server ID
DISCORD_GUILD_ID=

# YouTube channel to announce new uploads from (Tree Host's channel)
YOUTUBE_CHANNEL_ID=UCbkEF_PjOK5Z7CiaAXAvXWA
