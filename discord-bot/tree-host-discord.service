# Runs the Tree Host Discord bot 24/7 on the Linux server.
#   sudo cp /opt/tree-host/discord-bot/tree-host-discord.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tree-host-discord
#   journalctl -u tree-host-discord -f
[Unit]
Description=Tree Host Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=treehost
Group=treehost
WorkingDirectory=/opt/tree-host/discord-bot
ExecStart=/usr/bin/node src/bot.js
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/tree-host/discord-bot

[Install]
WantedBy=multi-user.target
