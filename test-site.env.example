# Private settings for the test site on this PC (Start.bat).
# Copy this file to "test-site.env" and fill in what you need. test-site.env is never committed.
# Lines starting with # are ignored; leave a value empty to keep the default.

# ---- Stripe (TEST mode only on this PC) ----
# Stripe Dashboard → turn on "Test mode" (top right) → Developers → API keys → "Secret key" (starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_your_key_here
# To receive payment confirmations on this PC, install the Stripe CLI and run:
#   stripe login
#   stripe listen --forward-to localhost:8766/api/billing/webhook
# It prints a webhook signing secret (whsec_...): paste it here, then restart Start.bat.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
BILLING_CURRENCY=usd

# ---- Who becomes the Owner (comma-separated emails) ----
# Sign in with one of these emails (verified) to become the Owner. Without it, the first account is the Owner.
TREEHOST_ADMIN_EMAILS=daniel@treehost.online

# ---- Emails (optional) ----
RESEND_API_KEY=re_your_key_here
MAIL_FROM=Tree Host <no-reply@treehost.online>

# ---- Firebase ----
# The web config is already built into Start.bat. To also store test data in the Realtime Database, put the
# service account key file next to Start.bat as tree-host-firebase.json (it's git-ignored). Test data goes to
# the "treehost-test" area, separate from the real site.
