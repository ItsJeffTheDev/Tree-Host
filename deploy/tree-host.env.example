# Tree Host settings. On the server this file is /etc/tree-host.env (only root can read it).
# After changing it: sudo systemctl restart tree-host

# ---- Website ----
TREEHOST_PUBLIC_URL=https://treehost.online
# The address players type in Minecraft (each server gets its own port, e.g. play.treehost.online:25600)
TREEHOST_GAME_HOST=play.treehost.online
# Ports handed out to customer servers (Docker opens them; keep the range in sync with your firewall/provider)
TREEHOST_PORTS=25600-25999
TREEHOST_PORT=8766
TREEHOST_DATA=/var/lib/tree-host
# Only if the website (not "play") is behind Cloudflare's orange-cloud proxy: trust its visitor IP header.
TREEHOST_TRUST_CLOUDFLARE=0

# ---- Admins ----
# Your email (comma-separated for more). Whoever signs up with it, once the email is verified, becomes an admin.
# Everyone else who signs up is a normal customer.
TREEHOST_ADMIN_EMAILS=daniel@treehost.online
# A private test site for invited testers: new accounts need this code. Share https://<your site>/dashboard?code=<it>.
# Leave empty on the real site.
TREEHOST_SIGNUP_CODE=

# ---- Business details (shown on the website, Terms and Privacy pages) ----
# The LLC's legal name, its mailing address, and the law that governs the Terms (e.g. "the State of Texas, USA")
TREEHOST_COMPANY=Tree Host
TREEHOST_ADDRESS=
TREEHOST_SUPPORT_EMAIL=support@treehost.online
# Billing questions (shown on the website, Reply-To on payment emails) and creator/partner contact
TREEHOST_BILLING_EMAIL=billing@treehost.online
TREEHOST_PROMO_EMAIL=promotion@treehost.online
TREEHOST_JURISDICTION=
TREEHOST_DISCORD_INVITE=
# Copyright (DMCA) agent shown on /dmca: register the same name, address and email at dmca.copyright.gov
TREEHOST_DMCA_EMAIL=dmca@treehost.online
TREEHOST_DMCA_AGENT=
# Countries (2-letter codes) that can't sign up or buy (OFAC sanctions; needs TREEHOST_TRUST_CLOUDFLARE=1 to know the country)
TREEHOST_BLOCKED_COUNTRIES=CU,IR,KP,SY
# Countries that can sign up but not buy yet, e.g. until you register for VAT: AT,BE,BG,...,GB
TREEHOST_CHECKOUT_BLOCKED_COUNTRIES=

# ---- Payments (Stripe) ----
# Start with the test keys (sk_test_...), switch to live keys (sk_live_...) when you launch.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks → your endpoint https://treehost.online/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=usd
# Set to 1 to test the whole flow without Stripe (plans activate for free). Never on a live site.
BILLING_DEMO=0

# ---- Firebase (sign-in + Realtime Database) ----
# The web config is public (it is sent to every browser); these are the values from the Firebase console.
FIREBASE_API_KEY=REDACTED
FIREBASE_AUTH_DOMAIN=tree-host.firebaseapp.com
FIREBASE_PROJECT_ID=tree-host
FIREBASE_DATABASE_URL=https://tree-host-default-rtdb.firebaseio.com
FIREBASE_APP_ID=1:840029330018:web:96c8dbdde3990b3fdccf3b
# SECRET: the service account key file (Firebase console → Project settings → Service accounts → Generate new private key).
# Without it, sign-in still uses Firebase but data is kept in local files only.
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/tree-host-firebase.json

# ---- Email for failed payments via https://resend.com (password reset emails are sent by Firebase) ----
RESEND_API_KEY=
MAIL_FROM=Tree Host <no-reply@treehost.online>

# ---- Nightly backups (deploy/backup.sh) ----
# Archives of worlds, server files and these settings. Copies on this machine only protect against mistakes:
# set an rsync target on another machine (e.g. a Hetzner Storage Box) to survive the server dying.
TREEHOST_BACKUP_DIR=/var/backups/tree-host
TREEHOST_BACKUP_KEEP=3
TREEHOST_BACKUP_RSYNC=
